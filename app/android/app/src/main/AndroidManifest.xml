<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Čte čas strávený v aplikacích, aby šel seznam při výběru seřadit podle
         skutečného používání. Uděluje se ručně v Nastavení (docs/spec.md §8),
         ne runtime dialogem. Blokace na tomhle oprávnění nezávisí. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Kotevní bod přes Bluetooth maják (docs/spec.md §5.3).

         `neverForLocation` je tu podstatné: bez něj by Android vyžadoval
         polohové oprávnění, protože z okolních majáků lze polohu odvodit.
         Kotva polohu neodvozuje a nechce ji — deklarace to říká systému
         i uživateli (docs/spec.md §9). -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />

    <!-- Android 11 a starší BLUETOOTH_SCAN neznají a skenování tam podmiňují
         polohovým oprávněním. Omezeno na tyto verze, ať si na novějších
         o polohu neříkáme zbytečně. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- NFC štítek jako kotva. Nepovinné: telefony bez NFC mají aplikaci
         normálně používat, jen bez tohohle typu kotvy. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <application
        android:label="Kotva"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Překryv místo blokované aplikace během fokus bloku.
             `excludeFromRecents` + `noHistory`, aby překryv nezůstával viset
             v přehledu úloh po skončení bloku. -->
        <activity
            android:name=".ShieldActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Obrazovka po vyčerpání denního limitu aplikace. -->
        <activity
            android:name=".LimitReachedActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />

        <!-- Odebírá notifikace z aplikací s vyčerpaným limitem. Volitelné —
             bez uděleného oprávnění limity fungují dál, jen notifikace chodí. -->
        <service
            android:name=".NotificationSuppressor"
            android:exported="false"
            android:label="@string/notification_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Blokovací služba (docs/spec.md §5.2). Oprávnění BIND_ACCESSIBILITY_SERVICE
             smí udělit jen systém; uživatel službu zapíná ručně v Nastavení. -->
        <service
            android:name=".KotvaAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Vydává soubor s exportem dat systémovému výběru (docs/spec.md §9).

             `exported="false"` + `grantUriPermissions="true"`: k provideru se
             nedostane žádná cizí aplikace sama od sebe, přístup dostane jen ta,
             které uživatel export výslovně předá — a jen k tomu jednomu
             souboru, jen na dobu intentu. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Zpřístupňuje seznam spustitelných aplikací pro výběr do blokovacího
             seznamu. Od Androidu 11 je viditelnost balíčků omezená a bez tohohle
             by `queryIntentActivities` vrátilo prázdno.

             Záměrně NEpoužíváme QUERY_ALL_PACKAGES: to je na Google Play
             restriktované oprávnění a pro náš účel zbytečně široké — stačí
             aplikace, které mají ikonu v launcheru. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>

        <!-- Launcher (plocha) má MAIN + HOME, ne MAIN + LAUNCHER. Bez tohohle
             se jeho název nepřeloží a v přehledu času svítí holý identifikátor
             balíčku místo čitelného jména. -->
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>
</manifest>
